# Scalpless web app (Next.js). NEXT_PUBLIC_* ids and BACKEND_URL are baked in at build time.
FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/shopify-app/package.json apps/shopify-app/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
ARG NEXT_PUBLIC_SUI_NETWORK=testnet
ARG NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
ARG NEXT_PUBLIC_SCALPLESS_PACKAGE_ID
ARG NEXT_PUBLIC_SCALPLESS_LATEST_PACKAGE_ID
ARG NEXT_PUBLIC_PASSPORT_REGISTRY_ID
ARG NEXT_PUBLIC_REGISTRY_OBJECT_ID
ARG NEXT_PUBLIC_LENDING_POOL_OBJECT_ID
ARG NEXT_PUBLIC_MARKET_OBJECT_ID
ARG BACKEND_URL
ENV NEXT_PUBLIC_SUI_NETWORK=$NEXT_PUBLIC_SUI_NETWORK NEXT_PUBLIC_SUI_RPC_URL=$NEXT_PUBLIC_SUI_RPC_URL \
    NEXT_PUBLIC_SCALPLESS_PACKAGE_ID=$NEXT_PUBLIC_SCALPLESS_PACKAGE_ID NEXT_PUBLIC_SCALPLESS_LATEST_PACKAGE_ID=$NEXT_PUBLIC_SCALPLESS_LATEST_PACKAGE_ID \
    NEXT_PUBLIC_PASSPORT_REGISTRY_ID=$NEXT_PUBLIC_PASSPORT_REGISTRY_ID NEXT_PUBLIC_REGISTRY_OBJECT_ID=$NEXT_PUBLIC_REGISTRY_OBJECT_ID \
    NEXT_PUBLIC_LENDING_POOL_OBJECT_ID=$NEXT_PUBLIC_LENDING_POOL_OBJECT_ID NEXT_PUBLIC_MARKET_OBJECT_ID=$NEXT_PUBLIC_MARKET_OBJECT_ID \
    BACKEND_URL=$BACKEND_URL NEXT_TELEMETRY_DISABLED=1
RUN npx next build apps/web
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "npx next start apps/web -p ${PORT:-3000}"]
