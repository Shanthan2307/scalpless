# ── Sui ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# Written by scripts/deploy-sui.ts
NEXT_PUBLIC_SCALPLESS_PACKAGE_ID=
# Latest upgrade (function calls); types keep the original id above
NEXT_PUBLIC_SCALPLESS_LATEST_PACKAGE_ID=
NEXT_PUBLIC_PASSPORT_REGISTRY_ID=
NEXT_PUBLIC_REGISTRY_OBJECT_ID=
NEXT_PUBLIC_LENDING_POOL_OBJECT_ID=
NEXT_PUBLIC_MARKET_OBJECT_ID=

# ── Backend ─────────────────────────────────────────────────────────────────────
PORT=4000
# 32-byte hex Ed25519 secret. Its public key must be Registry.verifier_pubkey on-chain
# (pnpm rotate-verifier). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTESTATION_SIGNER_KEY=
# 32+ random bytes, signs the World ID session cookie
SESSION_SECRET=

# ── World ID v4 (developer.world.org) ───────────────────────────────────────────
WORLD_APP_ID=
WORLD_RP_ID=
# RP signing key (server-only; used by signRequest to mint rp_context)
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=scalpless-passport
# production (real World App) | staging (World ID Simulator, app_staging_* apps)
WORLD_ENVIRONMENT=production
# Credentials requested at sign-in: proof_of_human (Orb) → tier 3, passport/mnc → tier 2,
# selfie → tier 1 (preview credential; add only once World enables it for your app)
WORLD_CREDENTIALS=proof_of_human,passport,mnc

# ── Web ─────────────────────────────────────────────────────────────────────────
# Where the Next.js dev server proxies /api/* to
BACKEND_URL=http://localhost:4000
